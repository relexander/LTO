<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_PSU_Status" Id="{9485fc45-b25d-4169-b897-203fc992f3ed}">
    <Declaration><![CDATA[TYPE ST_PSU_Status :
STRUCT
    // STATUS_WORD Bits
    bVout_Fault         : BOOL;
    bIout_Fault         : BOOL;
    bInput_Fault        : BOOL;
    bFan_Fault          : BOOL;
    bOff                : BOOL;
    bVout_OV_Fault      : BOOL;
    bIout_OC_Fault      : BOOL;
    bVin_UV_Fault       : BOOL;
    bTemperature_Fault  : BOOL;
    // STATUS_VOUT
    bVout_OV_Warn       : BOOL;
    bVout_UV_Warn       : BOOL;
    // STATUS_IOUT
    bIout_OC_Warn       : BOOL;
    bInCurrentLimit     : BOOL;  // TRUE = Netzteil in CC-Phase!
    // STATUS_TEMP
    bOT_Fault           : BOOL;
    bOT_Warning         : BOOL;
    // STATUS_FAN
    bFan1_Fault         : BOOL;
    bFan2_Fault         : BOOL;
    // Rohdaten
    wStatusWord         : WORD;
    wStateInternal      : WORD;
    sStateName          : STRING(32);
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>